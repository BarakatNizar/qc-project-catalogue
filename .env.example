# PostgreSQL connection string (development database for local development)
DATABASE_URL="postgresql://qc_user:qc_password@localhost:5432/qalamoon_compass?schema=public"

# Session signing secret: use a random value with at least 32 characters
SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters-long"

# Initial administrator provisioning only. The Admin is created outside the UI.
ADMIN_ID="admin"
ADMIN_PASS="change-this-before-provisioning"
ADMIN_NAME="QC Administrator"

# Main AI provider (server-side only)
AI_MAIN_PROVIDER="OPENROUTER"
AI_MAIN_BASE_URL="https://openrouter.ai/api/v1"
AI_MAIN_API_KEY=""
AI_MAIN_MODEL="openrouter/free"
AI_MAIN_TIMEOUT_MS="45000"

# Optional fallback. Uncomment and configure all four settings to enable it.
# AI_FALLBACK_PROVIDER="LOCAL"
# AI_FALLBACK_BASE_URL="http://127.0.0.1:9090/v1"
# AI_FALLBACK_API_KEY="not-needed-for-local-server"
# AI_FALLBACK_MODEL="your-local-model-id"
AI_FALLBACK_TIMEOUT_MS="60000"

# Optional public URL used by OpenRouter request metadata
NEXT_PUBLIC_APP_URL="http://localhost:3000"
