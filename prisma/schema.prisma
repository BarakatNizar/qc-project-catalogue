generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}


enum UserRole {
  ADMIN
  SUPERVISOR
  STUDENT
}

enum ProjectType {
  GRADUATION
  PRE_GRADUATION
}

enum ProjectVisibility {
  VISIBLE
  HIDDEN
}

enum ProjectFeatureScope {
  IN_SCOPE
  OUT_OF_SCOPE
}

enum AiProvider {
  OPENROUTER
  LOCAL
}
enum AiOperation {
  SUGGESTIONS
  PROJECT_EXTRACTION
}

enum AiExecutionStatus {
  RUNNING
  SUCCEEDED
  FAILED
}


enum AiLogLevel {
  INFO
  WARN
  ERROR
}

model User {
  id                    String               @id @default(uuid()) @db.Uuid
  role                  UserRole
  loginId               String               @unique @db.VarChar(120)
  passwordHash          String               @db.VarChar(255)
  name                  String               @db.VarChar(160)
  email                 String?              @unique @db.VarChar(254)
  collegeId             String?              @unique @db.VarChar(80)
  mustChangePassword    Boolean              @default(false)
  supervisorId          String?              @db.Uuid
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  supervisor            User?                @relation("StudentSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  supervisedStudents    User[]               @relation("StudentSupervisor")
  triggeredResponses    AiSuggestionResponse[] @relation("AiResponseTrigger")
  triggeredSuggestions  AiSuggestion[]       @relation("AiSuggestionTrigger")
  

  aiLogs AiLog[] @relation("AiLogTrigger")


  @@index([role, name])
  @@index([supervisorId])
  @@map("users")
}

model Project {
  id                   String               @id @default(uuid()) @db.Uuid

  title                String               @db.VarChar(200)
  summary              String               @db.VarChar(5000)
  description          String               @db.Text

  problemStatement     String              @db.Text
  proposedSolution     String              @db.Text
  objectives           String              @db.Text
  projectSupervisorName String?              @db.VarChar(160)
  features             ProjectFeature[] 
  technologies         ProjectTechnology[]
  targetUsers           String?  @db.Text
  constraints           String?  @db.Text
  availableResources    String?  @db.Text


  yearPresentation     String?              @db.VarChar(6)
  projectType          ProjectType
  visibility           ProjectVisibility    @default(VISIBLE)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt


  images               ProjectImage[]
  suggestionResponses  AiSuggestionResponse[]
  suggestions          AiSuggestion[]

  aiLogs AiLog[]


  @@index([visibility, projectType, createdAt])
  @@index([title])
  @@index([projectSupervisorName])
  @@map("projects")
}

model ProjectFeature {
  id        String             @id @default(uuid()) @db.Uuid
  projectId String             @db.Uuid
  content   String             @db.VarChar(500)
  scope     ProjectFeatureScope //IN | OUT
  sortOrder Int                @default(0)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  project   Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, scope, sortOrder])
  @@map("project_features")
}

model ProjectTechnology {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  name      String   @db.VarChar(100)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@index([projectId, sortOrder])
  @@map("project_technologies")
}

model ProjectImage {
  id            String   @id @default(uuid()) @db.Uuid
  projectId     String   @db.Uuid
  data          Bytes    @db.ByteA
  mimeType      String   @db.VarChar(80)
  fileName      String?  @db.VarChar(255)
  fileSizeBytes Int
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder])
  @@map("project_images")
}

model AiServiceSettings {
  id        String   @id @default("global") @db.VarChar(40)
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@map("ai_service_settings")
}


model AiProviderConfig {
  id               String   @id @default(uuid()) @db.Uuid
  name             String   @db.VarChar(80)
  provider         AiProvider
  baseUrl          String   @db.VarChar(500)
  encryptedApiKey  String?  @db.Text
  model            String   @db.VarChar(180)
  timeoutMs        Int      @default(45000)
  enabled          Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  suggestionResponses AiSuggestionResponse[]

  @@index([enabled, sortOrder])
  @@map("ai_provider_configs")
}

model AiSuggestionResponse {
  id                String          @id @default(uuid()) @db.Uuid
  projectId         String          @db.Uuid
  triggeredByUserId String?         @db.Uuid

  providerConfigId String? @db.Uuid
  aiLogId          String? @unique @db.Uuid
  
  provider          AiProvider
  model             String          @db.VarChar(180)
  responseContent   Json            @db.JsonB
  createdAt         DateTime        @default(now())
  project           Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  triggeredByUser   User?           @relation("AiResponseTrigger", fields: [triggeredByUserId], references: [id], onDelete: SetNull)
  suggestions       AiSuggestion[]

  providerConfig   AiProviderConfig? @relation(fields: [providerConfigId], references: [id], onDelete: SetNull)
  aiLog            AiLog? @relation(fields: [aiLogId], references: [id], onDelete: SetNull)


  @@index([projectId, createdAt])
  @@index([triggeredByUserId])
  @@map("ai_suggestion_responses")
}

model AiSuggestion {
  id                String               @id @default(uuid()) @db.Uuid
  projectId         String               @db.Uuid
  responseId        String               @db.Uuid
  triggeredByUserId String?              @db.Uuid
  title             String               @db.Text
  content           String               @db.Text
  createdAt         DateTime             @default(now())
  project           Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  response          AiSuggestionResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  triggeredByUser   User?                @relation("AiSuggestionTrigger", fields: [triggeredByUserId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([responseId])
  @@index([triggeredByUserId])
  @@map("ai_suggestions")
}




model AiLog {
  id                   String            @id @default(uuid()) @db.Uuid
  traceId              String            @unique @db.VarChar(64)
  operation            AiOperation
  status               AiExecutionStatus @default(RUNNING)
  level                AiLogLevel        @default(INFO)

  triggeredByUserId    String?           @db.Uuid
  projectId            String?           @db.Uuid

  startedAt            DateTime          @default(now())
  finishedAt           DateTime?
  durationMs           Int?

  // Used by efficient Prisma filters without querying JSON.
  providerTypes        String[]          @default([])
  finalProvider        AiProvider?
  finalProviderName    String?           @db.VarChar(80)
  finalProviderConfigId String?          @db.Uuid
  finalModel           String?           @db.VarChar(180)

  errorCode            String?           @db.VarChar(80)
  errorName            String?           @db.VarChar(120)
  errorMessage         String?           @db.VarChar(1000)
  failureStage         String?           @db.VarChar(80)
  failureKind          String?           @db.VarChar(80)

  // JSON snapshots of attempts/events, not separate rows.
  attempts             Json              @default("[]") @db.JsonB
  events               Json              @default("[]") @db.JsonB
  metadata             Json?             @db.JsonB

  triggeredByUser      User?             @relation("AiLogTrigger", fields: [triggeredByUserId], references: [id], onDelete: SetNull)
  project              Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  suggestionResponse   AiSuggestionResponse?

  @@index([operation, startedAt])
  @@index([status, startedAt])
  @@index([level, startedAt])
  @@index([triggeredByUserId, startedAt])
  @@index([projectId, startedAt])
  @@index([finalProvider, startedAt])
  @@index([providerTypes], type: Gin)
  @@map("ai_logs")
}
